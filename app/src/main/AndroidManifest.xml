<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The viewfinder reads camera frames back (design r4, Readback Mode): Spatial Data first, then Camera, asked one by one on the first screen (S00). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- SDK docs say read-back of camera input needs CAMERA only, but the 透写台 headset test found read-back needs CAMERA + SPATIAL_DATA (design container.permissions): ask for both -->
    <uses-permission android:name="com.picovr.permission.SPATIAL_DATA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FilterCam"
        tools:targetApi="31">

        <!-- SpatialML (the viewfinder) needs the experimental API flag (Low Vision Walk, design container.permissions). -->
        <meta-data
            android:name="pico.spatial.use_experimental_api"
            android:value="1" />

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.FilterCam">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Default spatial container: the camera window W1, a planar window in the Shared Space (design r4: 600 x 576 dp, system glass).
                 The filter window W2 and the room Stage are declared in Main.kt. -->
            <meta-data
                android:name="pico.spatial.windowcontainer.id"
                android:value="HomeWindow" />
            <meta-data
                android:name="pico.spatial.windowcontainer.style"
                android:value="1" />
            <meta-data
                android:name="pico.spatial.windowcontainer.defaultsize"
                android:value="600x576" />
            <meta-data
                android:name="pico.spatial.windowcontainer.defaultsize.unit"
                android:value="dp" />
            <meta-data
                android:name="pico.spatial.windowcontainer.resizetype"
                android:value="2" />
            <meta-data
                android:name="pico.spatial.windowcontainer.captionbar"
                android:value="0" />
            <meta-data
                android:name="pico.spatial.windowcontainer.materialbackground"
                android:value="1" />
        </activity>

        <!-- System pickers and the permission request (photo picker, .cube document, CAMERA). -->
        <activity
            android:name=".platform.HelperActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.FilterCam" />
    </application>

</manifest>
