<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera read-back on the shutter (design N16): asked when the camera source is picked (headset: right after the guide) or on the first camera shot. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- no com.picovr.permission.SPATIAL_DATA: only depth / positioning input needs it; the viewfinder uses the passthrough camera only (CAMERA for read-back) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FilterCam"
        tools:targetApi="31">

        <!-- SpatialML (the viewfinder) needs the experimental API flag (Low Vision Walk, design container.permissions). -->
        <meta-data
            android:name="pico.spatial.use_experimental_api"
            android:value="1" />

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.FilterCam">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Default spatial container: the main window P1, a planar window in the Shared Space (design 760 x 680 dp, narrowed to 680 x 680 dp so the viewfinder fits the view, QA #1 q1-3;
                 system glass). The room Stage, the lens spot is declared in Main.kt. -->
            <meta-data
                android:name="pico.spatial.windowcontainer.id"
                android:value="HomeWindow" />
            <meta-data
                android:name="pico.spatial.windowcontainer.style"
                android:value="1" />
            <meta-data
                android:name="pico.spatial.windowcontainer.defaultsize"
                android:value="680x680" />
            <meta-data
                android:name="pico.spatial.windowcontainer.defaultsize.unit"
                android:value="dp" />
            <meta-data
                android:name="pico.spatial.windowcontainer.resizetype"
                android:value="2" />
            <meta-data
                android:name="pico.spatial.windowcontainer.captionbar"
                android:value="0" />
            <meta-data
                android:name="pico.spatial.windowcontainer.materialbackground"
                android:value="1" />
        </activity>

        <!-- System pickers and the permission request (photo picker, .cube document, CAMERA). -->
        <activity
            android:name=".platform.HelperActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.FilterCam" />
    </application>

</manifest>
